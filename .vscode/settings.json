{
  // General editor settings
  "editor.formatOnSave": true,
  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 120,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "java.configuration.updateBuildConfiguration": "automatic",
  "js/ts.preferences.autoImportFileExcludePatterns": [
    "@ionic/angular/common",
    "@ionic/angular/directives",
    "@ionic/angular/index.d.ts",
    "@ionic/angular/providers"
  ],
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  "[swift]": {
    "editor.defaultFormatter": "swiftlang.swift-vscode"
  },
  "xml.format.maxLineWidth": 120,

  // Todo tree settings
  "todo-tree.general.tags": ["BUG", "HACK", "FIXME", "TODO", "INFO"],
  "todo-tree.highlights.defaultHighlight": {
    "type": "tag-and-comment",
    "foreground": "#000000"
  },
  "todo-tree.highlights.customHighlight": {
    "TODO": { "background": "#FFFF00" },
    "FIXME": { "background": "#FF0000" },
    "INFO": { "background": "#FFA500" }
  },
  "todo-tree.regex.regex": "(//|#|<!--|;|/\\*|\\*|/\\*\\*|^|^[ \\t]*(-|\\d+.))\\s*($TAGS)",

  // Prettier settings
  "prettier.singleQuote": true,
  "prettier.printWidth": 120,

  // Code spell checker ignored words
  "cSpell.words": ["Bootloader", "Buttonless", "Softdevice"]
}
